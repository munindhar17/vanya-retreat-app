<resources>
    <style name="Theme.Vanya" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/coral</item>
        <item name="colorAccent">@color/coral</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Vanya.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Vanya</item>
    </style>
</resources>
